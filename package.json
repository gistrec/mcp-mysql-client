{
  "name": "mcp-mysql-client",
  "version": "1.0.0",
  "description": "MCP server for a MySQL database — schema inspection, read-only queries and guarded writes of one database for AI agents.",
  "mcpName": "io.github.gistrec/mcp-mysql-client",
  "type": "module",
  "bin": {
    "mcp-mysql-client": "dist/index.js"
  },
  "files": [
    "dist",
    "test"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "smoke": "node --import tsx src/smoke.ts",
    "test": "npm run test:src && npm run test:dist",
    "test:src": "node --import tsx --test $(find src -name '*.test.ts')",
    "test:dist": "npm run build && node --test test/dist-smoke.test.js",
    "test:e2e": "npm run build && MYSQL_E2E=1 node --import tsx --test src/client.e2e.test.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mysql",
    "mariadb",
    "sql",
    "database",
    "read-only"
  ],
  "license": "MIT",
  "author": "gistrec <gistrec@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gistrec/mcp-mysql-client.git"
  },
  "homepage": "https://github.com/gistrec/mcp-mysql-client#readme",
  "bugs": {
    "url": "https://github.com/gistrec/mcp-mysql-client/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "mysql2": "^3.23.4",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0"
  }
}
